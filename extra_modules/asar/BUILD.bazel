load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "asar_fs_cc",
    srcs = ["asar_fs.cc"],
    hdrs = ["asar_fs.h"],
    include_prefix = "xff/asar",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/hash",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@mboworks_mbo//mbo/digest:digest_cc",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@nlohmann_json//:json",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

cc_test(
    name = "asar_fs_test",
    size = "small",
    srcs = ["asar_fs_test.cc"],
    deps = [
        ":asar_fs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/digest:digest_cc",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@nlohmann_json//:json",
        "@xff_extras_api//:vfs_cc",
    ],
)

# Exercises raw ASAR bytes and JSON-header inputs. The latter are wrapped in a valid size pickle by
# the harness, letting mutations reach the directory-record parser instead of spending every replay
# on the outer framing.
cc_fuzz_test(
    name = "asar_fs_fuzz_test",
    size = "small",
    srcs = ["asar_fs_fuzz_test.cc"],
    corpus = glob(["asar_fs_fuzz_test_corpus/**"]),
    dicts = ["asar_fs_fuzz_test.dict"],
    deps = [
        ":asar_fs_cc",
        "@abseil-cpp//absl/status",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

cc_library(
    name = "asar_register_cc",
    srcs = ["asar_register.cc"],
    hdrs = ["asar_register.h"],
    include_prefix = "xff/asar",
    visibility = ["//visibility:public"],
    deps = [
        ":asar_fs_cc",
        "@abseil-cpp//absl/status:statusor",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:archive_backend_cc",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
    alwayslink = True,
)

cc_test(
    name = "asar_register_test",
    size = "small",
    srcs = ["asar_register_test.cc"],
    deps = [
        ":asar_register_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:archive_backend_cc",
        "@xff_extras_api//:license_notice_cc",
    ],
)
