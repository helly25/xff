load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@xff_extras_api//:license_body.bzl", "license_body")
load("@xff_extras_api//:mime_database.bzl", "mime_database")

package(default_visibility = ["//visibility:private"])

license_body(
    name = "mit_license_cc",
    src = "licenses/MIT.txt",
    spdx = "MIT",
)

mime_database(
    name = "mime_db_data_cc",
    src = "data/mime-db.json",
    database_name = "mime-db 1.54.0",
)

cc_library(
    name = "mime_db_register_cc",
    srcs = ["mime_db_register.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":mime_db_data_cc",
        ":mit_license_cc",
        "@xff_extras_api//:license_notice_cc",
    ],
    alwayslink = True,
)

cc_test(
    name = "mime_db_register_test",
    size = "small",
    srcs = ["mime_db_register_test.cc"],
    deps = [
        ":mime_db_register_cc",
        "@googletest//:gtest_main",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:mime_database_cc",
    ],
)
