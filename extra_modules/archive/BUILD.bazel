load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The libarchive-backed archive reader: the archive build extra (#83), a target of the standalone
# @xff_archive module (this directory's MODULE.bazel). It depends only on @libarchive and the
# shared @xff_extras_api license-notice seam - never on the xff core - so the core keeps no
# knowledge of it and deleting this directory drops the extra entirely.
#
# This slice is the reader alone (headers -> Members). The VFS backend that turns those members
# into virtual entries, and the --archive wiring that mounts it, are later slices; the CLI surface
# already exists and errors self-documentingly until they land.
#
# `alwayslink` keeps the license-notice registration TU from being dropped by the linker.
cc_library(
    name = "archive_reader_cc",
    srcs = ["archive_reader.cc"],
    hdrs = ["archive_reader.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@libarchive//libarchive",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:member_path_cc",
    ],
    alwayslink = True,
)

# The write half of the phar reader: rewriting a native phar without some of its members. Its own
# target for the same reason the reader is - the format is hand-written, and libarchive cannot write it.
cc_library(
    name = "phar_writer_cc",
    srcs = ["phar_writer.cc"],
    hdrs = ["phar_writer.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@helly25_mbo//mbo/digest:digest_cc",
        "@helly25_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:member_path_cc",
    ],
)

cc_test(
    name = "phar_writer_test",
    size = "small",
    srcs = ["phar_writer_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_PHAR_FIXTURE_ANCHOR": "$(rootpath test_data/plain.phar)"},
    deps = [
        ":phar_reader_cc",
        ":phar_writer_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

# The one WRITE path: rewriting a container without some of its members (--archive-delete). Separate
# from the reader because reading a format does not imply writing it, and because a build that only
# ever lists archives should not link a writer.
# Writes a NEW archive from a list of files the walk matched: the counterpart of the reader, so an
# archive can be built from an expression rather than from a file list piped into tar. Format comes
# from the output NAME; entry naming and ordering are the caller's, since only it knows the roots.
cc_library(
    name = "archive_pack_cc",
    srcs = ["archive_pack.cc"],
    hdrs = ["archive_pack.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@helly25_mbo//mbo/status:status_macros_cc",
        "@libarchive//libarchive",
    ],
)

# Packs real files and reads the archive back: the round trip is what proves names, content, types
# and the format chosen from the output name. Also pins the refusals (an unknown output suffix, a
# missing source) and that a failure leaves no half archive behind.
# The xz slice of the pack coverage, split out ONLY to carry `no_san`: liblzma dispatches through a
# generically-typed function pointer, which UBSan's `function` check (clang 17+ applies it to C too)
# reports as UB inside xz. Probed format by format locally under -fsanitize=function - xz is the only
# one that trips it - so the quarantine is one target instead of the check being off repo-wide, and
# the pack writer keeps full ASan/UBSan coverage through every other format.
cc_test(
    name = "archive_pack_xz_test",
    size = "small",
    srcs = ["archive_pack_xz_test.cc"],
    tags = ["no_san"],
    deps = [
        ":archive_pack_cc",
        ":archive_reader_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "archive_pack_test",
    size = "small",
    srcs = ["archive_pack_test.cc"],
    deps = [
        ":archive_pack_cc",
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

cc_library(
    name = "archive_writer_cc",
    srcs = ["archive_writer.cc"],
    hdrs = ["archive_writer.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@libarchive//libarchive",
        "@xff_extras_api//:member_path_cc",
    ],
)

# Writes a real archive with libarchive, removes a member through our writer, and reads the result
# back: the round trip is what proves the surviving members keep their content and the container
# keeps its format and compression. Also pins the refusals (a format libarchive cannot write, a
# member that is not there) and that a failed rewrite leaves the original untouched.
cc_test(
    name = "archive_writer_test",
    size = "small",
    srcs = ["archive_writer_test.cc"],
    deps = [
        ":archive_reader_cc",
        ":archive_writer_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
        "@libarchive//libarchive",
    ],
)

# Round-trips real archives through libarchive: the test WRITES a tar (and a gzip-filtered tar) with
# libarchive's write API, then reads it back through our reader, so it proves the dependency links,
# the format/filter detection works, and the header fields map correctly - without committing binary
# fixtures. Also pins the two distinct error states (not an archive vs. corrupt archive).
cc_test(
    name = "archive_reader_test",
    size = "small",
    srcs = ["archive_reader_test.cc"],
    deps = [
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
        "@libarchive//libarchive",
        "@xff_extras_api//:license_notice_cc",
    ],
)

# The VFS backend: presents ONE archive as a read-only filesystem, so the whole expression grammar
# matches its members at virtual paths. Implements @xff_extras_api's seam (never the xff core), and
# spells member paths through member_path_cc so --archive-separator / --archive-prefix apply.
cc_library(
    name = "archive_fs_cc",
    srcs = ["archive_fs.cc"],
    hdrs = ["archive_fs.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/hash",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@helly25_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

# Round-trips a real tar through the backend: the test WRITES an archive with libarchive (including
# a nested member whose parent directories are NOT stored), then walks it through the seam. That is
# what proves the decisions hold - synthesized parents, read-only + kArchiveMember tagging, a
# refusing Remove, and ReadContent reporting Unimplemented rather than an empty string.
cc_test(
    name = "archive_fs_test",
    size = "small",
    srcs = ["archive_fs_test.cc"],
    deps = [
        ":archive_fs_cc",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
        "@libarchive//libarchive",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

# PHP's NATIVE phar format, which libarchive does not read at all: a PHP stub ending in
# `__HALT_COMPILER();` followed by a binary manifest and the member data. Same `Member` shape as the
# libarchive reader, so the VFS backend and the walk stay format-agnostic. The tar- and zip-based
# phar variants need nothing here - they are ordinary tars / zips for `:archive_reader_cc`.
cc_library(
    name = "phar_reader_cc",
    srcs = ["phar_reader.cc"],
    hdrs = ["phar_reader.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@bzip2//:bz2",
        "@helly25_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:member_path_cc",
        "@zlib",
    ],
)

# There is no phar WRITER to lean on, so the test builds containers byte by byte: the fixture is the
# format specification, and every field offset the reader relies on is pinned by a case that would
# read garbage if it were wrong (a non-empty alias, a second member's data offset, a lying member
# count).
cc_test(
    name = "phar_reader_test",
    size = "small",
    srcs = ["phar_reader_test.cc"],
    deps = [
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
        "@zlib",
    ],
)

# Reads the COMMITTED fixtures, which PHP itself wrote (test_data/README.md explains why they are
# checked in rather than generated during the test: a fixture from our own writer would only prove the
# reader is self-consistent, and the tests must not need a PHP interpreter).
#
# The `env` entry hands the test one fixture's runfiles path so it can derive the directory. That
# indirection is needed because this test lives in an EXTERNAL bazel module: its runfiles sit under
# the module's canonical repo directory, whose name (`xff_archive+`) is a bazel implementation detail
# a test must not hard-code, and $(rootpath) is the supported way to be told it.
cc_test(
    name = "phar_fixture_test",
    size = "small",
    srcs = ["phar_fixture_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_PHAR_FIXTURE_ANCHOR": "$(rootpath test_data/plain.phar)"},
    deps = [
        ":archive_fs_cc",
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

# Coverage for the PACKAGE formats that need no reader of their own - jar / wheel / npm tgz / gem /
# deb / rpm are zip, tar, ar or cpio wrappers, so libarchive already reads them and xff already dives
# into them. That was shipped behaviour with no test. Also records what libarchive does with a payload
# sitting BEHIND a prefix (self-extracting zips, CRX3, JMOD), which decides whether those formats need
# any mechanism of ours at all.
cc_test(
    name = "format_fixture_test",
    size = "small",
    srcs = ["format_fixture_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_ARCHIVE_FIXTURE_ANCHOR": "$(rootpath test_data/example.jar)"},
    deps = [
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

# Registers this extra into the core's archive seam - the only thing that makes `--archive` able to
# look inside a container. `alwayslink` because the registration is a static-init side effect with no
# symbol anyone references, so the linker would otherwise drop the whole TU.
cc_library(
    name = "archive_register_cc",
    srcs = ["archive_register.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":archive_fs_cc",
        ":archive_pack_cc",
        ":archive_reader_cc",
        ":archive_writer_cc",
        ":phar_writer_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@helly25_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:archive_backend_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
    alwayslink = True,
)

# Proves the registration actually happens by ASKING THE SEAM, not the class: a test that called
# ArchiveFileSystem::Open directly would pass even if the registrar were dropped, which is exactly the
# failure this guards (an `alwayslink` that someone removes looks fine until --archive stops working).
cc_test(
    name = "archive_register_test",
    size = "small",
    srcs = ["archive_register_test.cc"],
    deps = [
        ":archive_register_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:archive_backend_cc",
    ],
)
