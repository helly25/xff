load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The runtime FUSE loader (epic #183, slice 1): dlopen the platform's fuse3 library and resolve the
# mount server's symbol set, or report why the machine cannot mount. No build-time libfuse anywhere -
# see MODULE.bazel for why that is the design, not an omission.
cc_library(
    name = "fuse_loader_cc",
    srcs = ["fuse_loader.cc"],
    hdrs = ["fuse_loader.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "fuse_loader_test",
    size = "small",
    srcs = ["fuse_loader_test.cc"],
    deps = [
        ":fuse_loader_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
