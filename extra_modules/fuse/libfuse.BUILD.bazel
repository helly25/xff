# The BUILD overlay @xff_fuse's MODULE.bazel applies to the fetched libfuse release: the API headers
# as an INTERFACE-ONLY library. No libfuse source is compiled and nothing is linked - the runtime
# library is dlopened per machine (see fuse_loader) - so this target is exactly the type
# declarations the server compiles against.

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "fuse3_headers",
    hdrs = [
        "include/fuse_common.h",
        "include/fuse_log.h",
        "include/fuse_lowlevel.h",
        "include/fuse_opt.h",
    ],
    # The lowlevel API refuses to compile without an API-version choice; 30 is the base fuse3 API,
    # the widest match for whatever libfuse3 the loader finds at runtime. The three version macros
    # replace the meson-generated libfuse_config.h (its include is patched to be conditional -
    # libfuse_config_include.patch - so no generated header exists for a lint parse to miss).
    defines = [
        "FUSE_USE_VERSION=30",
        "FUSE_MAJOR_VERSION=3",
        "FUSE_MINOR_VERSION=18",
        "FUSE_HOTFIX_VERSION=2",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
)
