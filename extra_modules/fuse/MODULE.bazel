# The FUSE mount build extra (--archive-mount, epic #183) as a standalone Bazel module - the
# @xff_pcre2 / @xff_archive pattern. It carries NO build-time libfuse dependency on purpose: the
# ratified design loads the platform's FUSE library at RUNTIME (dlopen), because mounting is a
# per-machine capability (macFUSE is a user-installed kernel component) and one binary must run
# everywhere, degrading to extraction where FUSE is absent. See TODO.md's #183 build plan.

module(
    name = "xff_fuse",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.21")
bazel_dep(name = "abseil-cpp", version = "20250814.2")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "helly25_mbo", version = "0.13.0")
