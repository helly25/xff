# NO build-time libfuse dependency on purpose: the platform's FUSE library is loaded at RUNTIME
# (dlopen), because mounting is a per-machine capability (macFUSE is a user-installed kernel
# component) and one binary must run everywhere, degrading to extraction where FUSE is absent.

module(
    name = "xff_fuse",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.21")

# The fuse3 API headers, fetched from the PINNED libfuse release (never vendored - decided with the
# user 2026-08-15, TODO.md #183/3a). Only this module compiles against them, and only as INTERFACE
# declarations: `fuse_lowlevel_ops`'s field order is the ABI and `fuse_session_new` validates its
# size, so hand-declaring it would be a silent-corruption trap. The library itself is never linked -
# fuse_loader dlopens the machine's own libfuse3 at runtime. The release ASSET is used (stable
# checksum), not the auto-generated /archive/ tarball. libfuse is LGPL-2.1: interface-only use of a
# runtime-loaded library; the NOTICE component lands with the slice that links this extra into
# xff_full.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libfuse",
    build_file = "//:libfuse.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//:libfuse_config_include.patch"],
    sha256 = "f01de85717e20adf5f98aff324acd85dd73d61a5ca3834d573dcf0bd6e54a298",
    strip_prefix = "fuse-3.18.2",
    urls = ["https://github.com/libfuse/libfuse/releases/download/fuse-3.18.2/fuse-3.18.2.tar.gz"],
)
bazel_dep(name = "abseil-cpp", version = "20250814.2")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "helly25_mbo", version = "0.13.0")
bazel_dep(name = "xff_extras_api", version = "0.0.0")
