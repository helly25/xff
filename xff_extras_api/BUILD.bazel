load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The shared extras API, one target per seam. Both the xff core and each removable extra depend on
# these, so an extra never depends back into the core (which would be a cycle). `include_prefix`
# keeps each header's logical path (`xff/regex/backend.h`, `xff/license/notice.h`) unchanged.

# The RegexBackend plugin interface + PCRE2 registration slot. //xff/regex depends on this for the
# interface (Matcher::Compile(kPcre2) calls MakePcre2Backend); an extra backend implements
# RegexBackend and self-registers via Pcre2Registrar.
# The FUSE extra's registration slot: "is the mount extra linked into this binary". The core reads
# it for --help=extras / the notice line; @xff_fuse's registration TU fills it (epic #183 slice 4a).
cc_library(
    name = "fuse_backend_cc",
    srcs = ["fuse_backend.cc"],
    hdrs = ["fuse_backend.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        ":vfs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_test(
    name = "fuse_backend_test",
    size = "small",
    srcs = ["fuse_backend_test.cc"],
    deps = [
        ":fuse_backend_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "regex_backend_cc",
    srcs = ["backend.cc"],
    hdrs = ["backend.h"],
    include_prefix = "xff/regex",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)

# How an archive member is spelled as one path (`<container><separator><member>`), under the control
# of --archive-separator / --archive-prefix. It lives here because BOTH sides need it and an extra
# must not depend on the core: the archive extra RENDERS member paths, and the core PARSES one handed
# back in (a -cmp target, a {def.X}). Header-only deps beyond absl/strings.
# The seam through which the core opens an archive container without naming the extra that can do it -
# the archive counterpart of `:regex_backend_cc`'s PCRE2 slot, and for the same reason: the reader lives
# in a removable module. A build without the extra registers nothing and reports no support, which is
# what lets `--archive` say "not built into this binary" instead of failing inside the walk.
cc_library(
    name = "archive_backend_cc",
    srcs = ["archive_backend.cc"],
    hdrs = ["archive_backend.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":member_path_cc",
        ":vfs_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/functional:any_invocable",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "archive_backend_test",
    size = "small",
    srcs = ["archive_backend_test.cc"],
    deps = [
        ":archive_backend_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

cc_library(
    name = "member_path_cc",
    srcs = ["member_path.cc"],
    hdrs = ["member_path.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/strings",
    ],
)

# Pins the composition rules the design ratified, because each one is a decision rather than an
# implementation detail: plain concatenation (so an ABSOLUTE stored member keeps its leading slash,
# which is the Zip-Slip red flag), splitting at the FIRST separator with a verbatim remainder (so a
# member containing the separator survives), an arbitrary multi-character separator, and round-trip
# through Join -> Split for every separator spelling the ecosystem uses.
cc_test(
    name = "member_path_test",
    size = "small",
    srcs = ["member_path_test.cc"],
    deps = [
        ":member_path_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The license-notice registration seam: components self-register a Notice via a file-scope
# Registrar, and Notices() returns them sorted. The xff core (//xff/license) registers its own
# deps and assembles NoticeText() on top; each extra self-registers its notice from its own TU.
cc_library(
    name = "license_notice_cc",
    srcs = ["notice.cc"],
    hdrs = ["notice.h"],
    include_prefix = "xff/license",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
    ],
)

exports_files(["license_body.bzl"])

# The virtual-filesystem seam: the read-only FileSystem interface plus the Entry / Metadata types
# every backend produces. It lives here rather than in the core for the same reason the others do -
# an extra that implements a filesystem (archive diving, #83; remote later) must not depend back
# into the core. Header-only, and its only deps are abseil status/time, so hosting it costs the
# base module nothing. //xff/vfs re-exports it, so core code keeps including "xff/vfs/entry.h" and
# "xff/vfs/filesystem.h" unchanged.
cc_library(
    name = "vfs_cc",
    hdrs = [
        "entry.h",
        "filesystem.h",
    ],
    include_prefix = "xff/vfs",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
    ],
)

# The seam's contract, exercised by implementing it: the fake backend in this test is written using
# NOTHING but this module, which is the property that lets an extra provide a filesystem without
# depending on the xff core. It also pins the behaviours the engine relies on - per-path failures are
# statuses (so a walk continues), a read-only backend REFUSES removal instead of silently ignoring
# it, and an unset Entry/Metadata field means "ordinary real-filesystem entry" (read_only false).
cc_test(
    name = "vfs_test",
    size = "small",
    srcs = ["vfs_test.cc"],
    deps = [
        ":vfs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

# The license-notice seam's contract: notices sort by component regardless of the static-init order
# they were registered in (otherwise the generated NOTICE file would reorder itself between builds and
# the committed copy would drift), a Registrar contributes the whole notice (name + SPDX id + text,
# since a NOTICE must reproduce all of it), and Notices() hands back a copy so a caller assembling
# text cannot corrupt the registry.
cc_test(
    name = "notice_test",
    size = "small",
    srcs = ["notice_test.cc"],
    deps = [
        ":license_notice_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The RegexBackend seam's contract, exercised by implementing it with a trivial literal backend -
# again using nothing but this module, which is the property the extras split exists to guarantee.
# Also pins the registration slot: UNREGISTERED reports Unimplemented ("not built into this binary",
# never confused with a bad pattern and never a silent RE2 fallback), and after a factory registers,
# the grammar reports available, receives case_insensitive, and a rejected pattern stays
# InvalidArgument.
cc_test(
    name = "backend_test",
    size = "small",
    srcs = ["backend_test.cc"],
    deps = [
        ":regex_backend_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)
