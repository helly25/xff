{
  "include": [
    "xff/**",
    "xff_extras_api/**",
    "xff_archive/**",
    "xff_fuse/**",
    "xff_pcre2/**"
  ],
  "data_only_extras": ["xff_mime_db"],
  "exclude": [
    "**/*_benchmark.cc",
    "**/*_fuzz_test.cc",
    "**/*_test.cc",
    "**/*_test.h"
  ],
  "minimum": { "lines": 90, "functions": 90, "branches": 80 },
  "target": { "lines": 92, "functions": 95, "branches": 82 },
  "enforce": "high",
  "patch": {
    "minimum": { "lines": 95, "branches": 85 },
    "target": { "lines": 98, "branches": 90 },
    "enforce": "medium"
  },
  "categories": {
    "program": {
      "command line": { "include": ["xff/cli/**"] },
      "configuration": { "include": ["xff/config/**", "xff/env/**"] },
      "command grammar": { "include": ["xff/parser/**", "xff/registry/**"] },
      "execution": { "include": ["xff/engine/**", "xff/exec/**"] },
      "filesystem": {
        "include": ["xff/filesystem/**", "xff/shard/**", "xff/vfs/**"]
      },
      "matching": {
        "include": [
          "xff/matching/**",
          "xff/content/**",
          "xff/fuzzy/**",
          "xff/glob/**",
          "xff/hash/**"
        ]
      },
      "presentation": {
        "include": [
          "xff/presentation/**",
          "xff/datetime/**",
          "xff/values/**",
          "xff/license/**"
        ]
      }
    },
    "extensions": {
      "API": {
        "include": ["xff_extras_api/**"],
        "minimum": { "lines": 97, "branches": 87 }
      },
      "archive": {
        "include": ["xff_archive/**"]
      },
      "FUSE": {
        "include": ["xff_fuse/**"]
      },
      "language database": {
        "include": ["xff_language_db/**"]
      },
      "PCRE2": {
        "include": ["xff_pcre2/**"],
        "minimum": { "lines": 98, "functions": 98, "branches": 87 }
      }
    }
  }
}
