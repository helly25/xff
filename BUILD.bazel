load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")

package(default_visibility = ["//visibility:private"])

# The compile database clang-tidy and clangd read, generated by ./compile_commands-update.sh.
#
# It exists as an explicit target rather than the extractor's stock `refresh_all` because
# `refresh_all` covers `//...` only, and the composable extras are separate bazel MODULES
# (`extra_modules/*`, reached as `@xff_archive` / `@xff_pcre2`) that no `//...` pattern matches. The
# consequence was a silent blind spot: every extras translation unit was absent from the database, so
# clang-tidy could not even resolve the extra's own header (`'xff/archive/archive_reader.h' file not
# found`) and its findings there were meaningless. Each extra also needs its own build flag, which is
# what the per-target value in this dict is for - without the flag the extra's targets do not build.
#
# This list stays literal because it needs each extra's BUILD FLAG, and a flag name is not derivable
# from a module name (`xff_pcre2`'s flag is `--//xff:xff_pcre`). Everywhere else the extras are derived
# from MODULE.bazel by tools/extras.py; here the `check-extras-covered` pre-commit hook asserts this
# dict still covers exactly the extras MODULE.bazel declares, because an extra missing from it is
# invisible to clang-tidy and clangd, which fails OPEN - it looks clean rather than loud.
refresh_compile_commands(
    name = "refresh_compile_commands",
    targets = {
        "//...": "",
        "@xff_archive//...": "--//xff:xff_archive",
        "@xff_pcre2//...": "--//xff:xff_pcre",
    },
)

filegroup(
    name = "clang-format",
    srcs = [".clang-format"],
    visibility = ["//visibility:public"],
)

# LICENSE + NOTICE are compiled into the binary (see //xff/cli:notices_gen) so a single-file
# release reproduces its own third-party notices.
exports_files(
    [
        "LICENSE",
        "NOTICE",
    ],
    visibility = ["//visibility:public"],
)

# XFF.md is the committed Markdown reference, verbatim `xff_full --markdown` output. It is generated,
# not hand-written: //xff/cli:xff_markdown_test regenerates it and fails on any drift, and
# ./xff-md-update.sh rewrites it. Exported so that drift guard can diff against it.
exports_files(
    ["XFF.md"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_clang",
    define_values = {"is_clang": "true"},
)
