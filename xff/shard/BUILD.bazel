load("//xff:cc.bzl", "cc_library", "cc_test")

# Sharded-file detection (#84): decodes a single filename into its logical shard
# identity (stem / index / total / tail). Grouping, dedup, completeness and the
# `--shards` CLI surface layer on top. See docs/design.md "Sharded files".
cc_library(
    name = "shard_cc",
    srcs = ["shard.cc"],
    hdrs = ["shard.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@re2",
    ],
)

cc_test(
    name = "shard_test",
    size = "small",
    srcs = ["shard_test.cc"],
    deps = [
        ":shard_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@helly25_mbo//mbo/testing:status_cc",
    ],
)

# Grouping (#84 slice B): collapses decoded shard filenames into logical sets, dedups
# same-index regenerations (differing only by tail), and surfaces completeness gaps.
cc_library(
    name = "group_cc",
    srcs = ["group.cc"],
    hdrs = ["group.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":shard_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "group_test",
    size = "small",
    srcs = ["group_test.cc"],
    deps = [
        ":group_cc",
        ":shard_cc",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
