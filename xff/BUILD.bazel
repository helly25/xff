# Build-time "composable extras" flags. Heavy / special dependencies are OFF by default so the
# stock `//xff/cli:xff` is a lean core; the extended `//xff/cli:xff_full` binary is composed from
# the same source tree by turning extras on. `bazel build --config=xff_full //xff/cli:xff_full` builds
# the full binary with every extra; a single extra can still be dropped from an otherwise-full
# build on the command line (e.g. `--config=xff_full --//xff:xff_pcre=false //xff/cli:xff_full`).
#
# Each extra is a self-registering backend target (under `extra_modules/`) that only `xff_full` links,
# via a `select()` on the extra's `config_setting`. Presence is detected at runtime from the
# registry the backend registers into (e.g. `xff::regex::Pcre2Available()`), so there is no
# `#ifdef` in the core and the lean binary simply never links the target - deleting the
# `extra_modules/` directory makes a `--//xff:xff_<extra>` build fail to compile while the lean build
# still builds. The matching CLI surface (`--regextype=PCRE2`, `--archive`, ...) is ALWAYS present;
# using an extra in a build that did not link it is a hard immediate error, never a silent no-op.
# See TODO.md "Composable-extras" and docs/design-config.md.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//xff:cc.bzl", "cc_library", "cc_test")
load("//xff:extras.bzl", "XFF_EXTRAS", "all_extras_deps")

package(default_visibility = ["//visibility:public"])

# One `--//xff:xff_<flag>` per composable extra, plus its `:xff_<flag>_enabled` condition, GENERATED
# from the XFF_EXTRAS list (//xff:extras.bzl) rather than written out per extra: the list is the single
# place an extra is wired, so a new one cannot arrive with a flag but no condition, or a condition the
# full build forgets. Default off, which is what makes `//xff/cli:xff` lean.
# (Build flags carry the `xff_` package prefix, like the library flags in STYLE_CPP.md.)
[
    bool_flag(
        name = extra.flag,
        build_setting_default = False,
    )
    for extra in XFF_EXTRAS
]

[
    config_setting(
        name = extra.flag + "_enabled",
        flag_values = {":" + extra.flag: "True"},
    )
    for extra in XFF_EXTRAS
]

# --//xff:xff_msan -- set by --config=msan (see .bazelrc). It exists so the cc_* wrappers in
# xff/cc.bzl (and the two genrules that RUN the instrumented binary) can `select()` the MSan runtime
# suppression file in ONLY in an MSan build: it is meaningless without -fsanitize=memory, and
# declaring the input unconditionally would add it to every action in every configuration.
# It does NOT gate the instrumented libc++ - that is the toolchain's `--features=msan`.
bool_flag(
    name = "xff_msan",
    build_setting_default = False,
)

config_setting(
    name = "xff_msan_enabled",
    flag_values = {":xff_msan": "True"},
)

# The single "is this the full / extras build" condition: an OR over every extra's own condition, so
# it needs no edit when one lands. Both XFF_FULL_ONLY (xff_full's compatibility gate, //xff:extras.bzl)
# and the //xff alias below key on THIS, so "full mode" is defined in exactly one place. (Linking a
# specific backend stays keyed on that extra's `:xff_<flag>_enabled` - "is pcre on" is a different
# question from "is this the full build".)
selects.config_setting_group(
    name = "full_build",
    match_any = [":" + extra.flag + "_enabled" for extra in XFF_EXTRAS],
)

# What `xff_full` links: every extra that is turned ON, and nothing about them anywhere else. One
# `select` per extra keyed on its own flag, generated from XFF_EXTRAS - so `--config=xff_docs` (all
# extras) and `--config=xff_full --//xff:xff_pcre=false` (drop one) both fall out, and a binary never
# needs to name an extra. `alwayslink` lives on each extra's own registration target, which is what
# makes the static-init self-registration survive linking.
cc_library(
    name = "all_extras_cc",
    deps = all_extras_deps(),
)

# `//xff` == the right binary for the active build config: the extended //xff/cli:xff_full in a full
# build (:full_build), else the lean //xff/cli:xff. So `bazel run //xff -- ...` follows your config -
# default it to --config=xff_full and //xff transparently means the full tool - without spelling out
# the //xff/cli path. The two underlying binaries stay explicit and config-stable (//xff/cli:xff is
# always lean, //xff/cli:xff_full always full); only this convenience alias adapts. It keys on the same
# :full_build as XFF_FULL_ONLY (xff_full's compatibility gate), so the alias can never resolve to an
# incompatible target.
alias(
    name = "xff",
    actual = select({
        ":full_build": "//xff/cli:xff_full",
        "//conditions:default": "//xff/cli:xff",
    }),
)

# The delivery half of the suppression plumbing, which nothing tested: a `*_OPTIONS` variable naming a
# suppressions file must find that file at run time. Uses the cc.bzl wrapper deliberately - the wrapper
# is what puts the file in the runfiles, so a test declared any other way would prove nothing.
cc_test(
    name = "suppressions_delivery_test",
    size = "small",
    srcs = ["suppressions_delivery_test.cc"],
    deps = [
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
