load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Named-field template rendering: {field} substitution for --format and -exec.
cc_library(
    name = "fields_cc",
    srcs = ["fields.cc"],
    hdrs = ["fields.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/content:line_match_cc",
        "//xff/datetime:datetime_cc",
        "//xff/env:env_cc",
        "//xff/hash:hash_cc",
        "//xff/matching/language:language_cc",
        "//xff/matching/mime:mime_cc",
        "//xff/matching/regex:regex_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
        "@helly25_mbo//mbo/container:limited_map_cc",
    ],
)

cc_test(
    name = "fields_test",
    size = "small",
    srcs = ["fields_test.cc"],
    deps = [
        ":fields_cc",
        "//xff/env:env_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
