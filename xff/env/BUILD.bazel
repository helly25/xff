load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# Centralized, mutex-guarded, read-once access to the process environment: the single getenv
# site in the codebase (see env.h). Every other module reads the environment through this.
cc_library(
    name = "env_cc",
    srcs = ["env.cc"],
    hdrs = ["env.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "env_test",
    size = "small",
    srcs = ["env_test.cc"],
    deps = [
        ":env_cc",
        "@abseil-cpp//absl/types:span",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
